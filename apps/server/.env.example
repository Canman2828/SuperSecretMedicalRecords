PORT=4000

# Local Mongo or an Atlas connection string.
# Leave blank to run without a database (guest mode only: search, interactions, explain still work).
MONGODB_URI=mongodb://127.0.0.1:27017/medifyrx

JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API (web dev server).
# The iOS app isn't a browser, so CORS doesn't apply to it.
CORS_ORIGINS=http://localhost:5173

# Optional. A Google Gemini API key (https://aistudio.google.com/apikey).
# Needed for the chat assistant and AI plain-language explanations (/api/explain).
AI_API_KEY=

# Optional. Outgoing mail for password-reset links, e.g. smtp://user:pass@smtp.example.com:587
# Leave blank in development: reset links are printed in the server console instead.
SMTP_URL=
MAIL_FROM=medify.Rx <no-reply@example.com>
# Optional. Base URL used in reset links. Defaults to the first CORS_ORIGINS entry.
APP_URL=
