{
  "expo": {
    "name": "medify.Rx",
    "slug": "medifyrx",
    "scheme": "medifyrx",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.medifyrx.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "medify.Rx uses the camera to highlight and explain medical terms on your prescription. Images are not saved."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
